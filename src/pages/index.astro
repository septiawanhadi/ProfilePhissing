---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Navbar from '../layouts/Navbar.astro';
import Ticker from '../components/Ticker.tsx';
import SocialProof from '../components/SocialProof.astro';
import Hero from '../components/Hero.tsx';
import Services from '../components/Services.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Process from '../components/Process.tsx';
import Portfolio from '../components/Portfolio.tsx';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.tsx';
import Contact from '../components/Contact.tsx';
import InstagramGallery from '../components/InstagramGallery.tsx';
import Footer from '../components/Footer.astro';
---

<Layout title="Dripcode — Performance-Driven Web Solutions for Growing Businesses">
  <Header />
  <Navbar />
  <Ticker client:load />
  
  <main class="bg-[var(--color-bg)]">
    <SocialProof />
    <Hero client:load />
    <Services />
    <WhyChooseUs />
    <Process client:load />
    <Portfolio client:load />
    <Team />
    <Faq client:load />
    <Contact client:load />
    <InstagramGallery client:load />
  </main>
  
  <Footer />
</Layout>
