---
// Team.astro — Founders introduction with halftone portrait placeholders
const founders = [
  {
    name: "Didra Rayyan Herlambang",
    roleEn: "Full-Stack Developer & Co-Founder",
    roleId: "Full-Stack Developer & Co-Founder",
    bioEn: "Specializes in enterprise web revamps, SEO architecture, and AI integrations. Currently engineering at PT Berlian Sistem Informasi. Built manyarmotor.com (100/100 Lighthouse) and the Safetana AI chatbot system.",
    bioId: "Spesialisasi dalam perbaikan web perusahaan, arsitektur SEO, dan integrasi AI. Saat ini bekerja sebagai engineer di PT Berlian Sistem Informasi. Membangun manyarmotor.com (Lighthouse 100/100) dan sistem chatbot AI Safetana.",
    github: "https://github.com/didradev",
    portfolio: "https://didradev.netlify.app/",
    initials: "DRH",
    photo: "/didra.png",
  },
  {
    name: "Septiawan Hadi Prasetyo",
    roleEn: "Full-Stack Developer | AI & Data Analyst & Founder",
    roleId: "Full-Stack Developer | Analis Data & AI & Founder",
    bioEn: "Specializes in accessible interfaces, digital forensics, and school management systems. Built the Sidik-TI forensics platform and the SLB Raudhatul Zannah school portal — both achieving WCAG AAA accessibility ratings.",
    bioId: "Spesialisasi dalam antarmuka aksesibel, forensik digital, dan sistem manajemen sekolah. Membangun platform forensik Sidik-TI dan portal sekolah SLB Raudhatul Zannah — keduanya meraih peringkat aksesibilitas WCAG AAA.",
    github: "https://github.com/septiawanhadi",
    portfolio: "https://septiawanhadi.github.io/septiawanhadip/",
    initials: "SHP",
    photo: "/septiawan.png",
  }
];
---

<section class="max-w-screen-xl mx-auto px-4 py-16 border-b-2 border-[var(--color-fg)] bg-[var(--color-bg)]">
  <!-- Section Header -->
  <div class="mb-12 border-b-2 border-[var(--color-fg)] pb-4">
    <div class="font-mono text-xs uppercase tracking-widest text-neutral-600 font-bold mb-2">
      <span class="lang-en">Team // The People Behind the Code</span>
      <span class="lang-id">Tim // Orang-orang di Balik Kode</span>
    </div>
    <h2 class="font-serif text-4xl md:text-5xl font-black uppercase text-[var(--color-fg)] tracking-tight">
      <span class="lang-en">WHO WE ARE</span>
      <span class="lang-id">TENTANG KAMI</span>
    </h2>
  </div>

  <!-- 2-Column Team Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border border-[var(--color-fg)] bg-[var(--color-bg-card)]">
    {founders.map((founder, idx) => (
      <div class={`p-8 ${idx === 0 ? 'border-b md:border-b-0 md:border-r border-[var(--color-fg)]' : ''}`}>
        <!-- Halftone Portrait Photo / Placeholder -->
        <div class="border border-[var(--color-fg)] p-2 bg-[var(--color-bg-card)] mb-6 group">
          <div class="h-48 bg-[var(--color-bg)] relative flex items-center justify-center overflow-hidden">
            {founder.photo ? (
              <img 
                src={founder.photo} 
                alt={founder.name} 
                class="absolute inset-0 w-full h-full object-contain grayscale contrast-125 transition-transform duration-500 group-hover:scale-105"
              />
            ) : null}
            <div class="absolute inset-0 bg-[radial-gradient(var(--color-fg)_1px,transparent_1px)] opacity-15 [background-size:6px_6px] pointer-events-none"></div>
            <div class="absolute inset-0 bg-[linear-gradient(var(--color-border-subtle)_50%,transparent_50%)] [background-size:100%_3px] pointer-events-none"></div>
            {!founder.photo && (
              <div class="z-10 text-center transition-transform duration-500 group-hover:scale-110">
                <div class="font-serif text-5xl font-black text-neutral-700">{founder.initials}</div>
              </div>
            )}
          </div>
        </div>

        <!-- Name & Role -->
        <h3 class="font-serif text-2xl font-bold uppercase text-[var(--color-fg)] mb-1 leading-tight">{founder.name}</h3>
        <div class="font-mono text-[10px] uppercase tracking-widest text-[var(--color-accent)] font-bold mb-4">
          <span class="lang-en">{founder.roleEn}</span>
          <span class="lang-id">{founder.roleId}</span>
        </div>

        <!-- Bio -->
        <p class="font-body text-sm text-neutral-600 text-justify mb-6 leading-relaxed">
          <span class="lang-en">{founder.bioEn}</span>
          <span class="lang-id">{founder.bioId}</span>
        </p>

        <!-- Social Links -->
        <div class="flex gap-3">
          <a href={founder.github} target="_blank" rel="noopener noreferrer" class="border border-[var(--color-fg)] px-3 py-2 font-mono text-[10px] uppercase tracking-widest font-bold hover:bg-[var(--color-hover-bg)] hover:text-[var(--color-hover-text)] transition-colors" aria-label={`${founder.name} GitHub`}>
            GitHub
          </a>
          <a href={founder.portfolio} target="_blank" rel="noopener noreferrer" class="border border-[var(--color-fg)] px-3 py-2 font-mono text-[10px] uppercase tracking-widest font-bold hover:bg-[var(--color-hover-bg)] hover:text-[var(--color-hover-text)] transition-colors" aria-label={`${founder.name} Portfolio`}>
            Portfolio
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
