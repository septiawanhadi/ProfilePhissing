---
// Header.astro — Professional masthead for international SMB audience
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }).toUpperCase();
---

<header class="max-w-screen-xl mx-auto px-4 pt-6 pb-2 border-b-4 border-[#111111]">
  <!-- Top Masthead Info -->
  <div class="grid grid-cols-2 md:grid-cols-3 border-b border-[#111111] pb-2 text-xs font-mono uppercase tracking-widest text-neutral-600">
    <div class="hidden md:block">
      EST. 2026 · JAKARTA
    </div>
    <div class="text-left md:text-center font-bold text-[#CC0000]">
      {today}
    </div>
    <div class="text-right">
      ENGLISH EDITION
    </div>
  </div>

  <!-- Giant Newspaper Nameplate -->
  <div class="py-6 text-center select-none">
    <h1 class="font-serif text-7xl md:text-[8rem] lg:text-[10rem] font-black leading-[0.8] tracking-tighter uppercase text-[#111111]">
      WEB CUNTS
    </h1>
    <div class="mt-4 font-body italic text-lg md:text-xl text-neutral-700 tracking-wide border-t border-b border-[#111111] py-1">
      Performance-Driven Web Solutions for Growing Businesses
    </div>
  </div>

  <!-- Location & Availability Bar -->
  <div class="flex flex-col sm:flex-row justify-between items-center border-t border-b-2 border-[#111111] py-2 text-xs font-mono uppercase tracking-widest text-neutral-700 gap-1">
    <div>
      SERVING: LONDON · EUROPE · US · SINGAPORE
    </div>
    <div class="text-neutral-500">
      AVAILABLE FOR REMOTE PROJECTS WORLDWIDE
    </div>
  </div>

  <!-- Nav Bar -->
  <nav class="flex flex-wrap justify-center gap-x-8 gap-y-2 py-3 text-xs md:text-sm font-sans font-bold uppercase tracking-widest" aria-label="Main navigation">
    <a href="#home" class="hover:text-[#CC0000] underline-offset-4 hover:underline decoration-2 decoration-[#CC0000] transition-colors" id="nav-home">Home</a>
    <a href="#services" class="hover:text-[#CC0000] underline-offset-4 hover:underline decoration-2 decoration-[#CC0000] transition-colors" id="nav-services">Services</a>
    <a href="#why-choose-us" class="hover:text-[#CC0000] underline-offset-4 hover:underline decoration-2 decoration-[#CC0000] transition-colors" id="nav-why-choose-us">Why Us</a>
    <a href="#work" class="hover:text-[#CC0000] underline-offset-4 hover:underline decoration-2 decoration-[#CC0000] transition-colors" id="nav-work">Work</a>
    <a href="#faq" class="hover:text-[#CC0000] underline-offset-4 hover:underline decoration-2 decoration-[#CC0000] transition-colors" id="nav-faq">FAQ</a>
    <a href="#contact" class="hover:text-[#CC0000] underline-offset-4 hover:underline decoration-2 decoration-[#CC0000] transition-colors" id="nav-contact">Contact</a>
  </nav>
</header>
