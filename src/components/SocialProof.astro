---
// SocialProof.astro — Compact trust metrics strip
const stats = [
  { value: "10+", label: "Projects Delivered" },
  { value: "3", label: "Countries Served" },
  { value: "100/100", label: "Lighthouse Average" },
  { value: "< 4hrs", label: "Response Time" },
];
---

<section class="max-w-screen-xl mx-auto px-4 py-6 border-b-2 border-[#111111]" aria-label="Key metrics">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-0 border border-[#111111] bg-[#111111] text-[#F9F9F7]">
    {stats.map((stat, idx) => (
      <div class={`p-4 md:p-6 text-center ${idx < 3 ? 'border-r border-[#F9F9F7]/10' : ''} ${idx < 2 ? 'border-b md:border-b-0 border-[#F9F9F7]/10' : ''}`}>
        <div class="font-serif text-3xl md:text-4xl font-black leading-none mb-1 text-[#F9F9F7]">
          {stat.value}
        </div>
        <div class="font-mono text-[10px] uppercase tracking-widest text-neutral-400 font-bold">
          {stat.label}
        </div>
      </div>
    ))}
  </div>
</section>
