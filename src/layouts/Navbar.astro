---
// Navbar.astro — Modular navigation bar with language selector toggle and collapsible mobile drawer
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const homePrefix = isHome ? '' : '/';
---

<!-- Sticky Nav Bar -->
<div class="sticky top-0 z-50 bg-[var(--color-bg)] border-b-4 border-[var(--color-fg)] w-full order-first md:order-none">
  <div class="max-w-screen-xl mx-auto px-4">
    <nav class="relative py-3 text-xs md:text-sm font-sans font-bold uppercase tracking-widest" aria-label="Main navigation">
      
      <!-- Top Row Container: Flex justify-between on mobile, center on desktop -->
      <div class="flex items-center justify-between md:justify-center w-full">
        <!-- Menu Button (Visible on mobile only) -->
        <button id="mobile-menu-btn" class="md:hidden flex items-center gap-2 border border-[var(--color-fg)] bg-[var(--color-bg-card)] px-3 py-1.5 hover:bg-[var(--color-hover-bg)] hover:text-[var(--color-hover-text)] transition-all duration-150 font-mono text-xs font-bold" aria-expanded="false" aria-controls="mobile-menu-drawer">
          <span class="menu-text-open lang-en">MENU</span>
          <span class="menu-text-open lang-id">MENU</span>
          <span class="menu-text-close lang-en hidden">CLOSE</span>
          <span class="menu-text-close lang-id hidden">TUTUP</span>
          <svg class="h-3 w-3 fill-none stroke-current stroke-[3]" viewBox="0 0 24 24" id="menu-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" class="menu-icon-bars" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" class="menu-icon-cross hidden" />
          </svg>
        </button>

        <!-- Desktop Links: Hidden on Mobile, Centered on Desktop -->
        <div class="hidden md:flex flex-wrap gap-x-8 gap-y-2 justify-center">
          <a href={`${homePrefix}#home`} class="hover:text-[var(--color-accent)] underline-offset-4 hover:underline decoration-2 decoration-[var(--color-accent)] transition-colors" id="nav-home">
            <span class="lang-en">Home</span>
            <span class="lang-id">Beranda</span>
          </a>
          <a href={`${homePrefix}#services`} class="hover:text-[var(--color-accent)] underline-offset-4 hover:underline decoration-2 decoration-[var(--color-accent)] transition-colors" id="nav-services">
            <span class="lang-en">Services</span>
            <span class="lang-id">Layanan</span>
          </a>
          <a href={`${homePrefix}#why-choose-us`} class="hover:text-[var(--color-accent)] underline-offset-4 hover:underline decoration-2 decoration-[var(--color-accent)] transition-colors" id="nav-why-choose-us">
            <span class="lang-en">Why Us</span>
            <span class="lang-id">Mengapa Kami</span>
          </a>
          <a href={`${homePrefix}#work`} class="hover:text-[var(--color-accent)] underline-offset-4 hover:underline decoration-2 decoration-[var(--color-accent)] transition-colors" id="nav-work">
            <span class="lang-en">Work</span>
            <span class="lang-id">Portofolio</span>
          </a>
          <a href={`${homePrefix}#faq`} class="hover:text-[var(--color-accent)] underline-offset-4 hover:underline decoration-2 decoration-[var(--color-accent)] transition-colors" id="nav-faq">
            <span class="lang-en">FAQ</span>
            <span class="lang-id">Tanya Jawab</span>
          </a>
          <a href={`${homePrefix}#contact`} class="hover:text-[var(--color-accent)] underline-offset-4 hover:underline decoration-2 decoration-[var(--color-accent)] transition-colors" id="nav-contact">
            <span class="lang-en">Contact</span>
            <span class="lang-id">Kontak</span>
          </a>
        </div>

        <!-- Actions Container (Theme Toggle + Language Selector): aligned right on mobile, absolute right on desktop -->
        <div class="flex items-center gap-2 relative md:absolute md:right-0 md:top-1/2 md:-translate-y-1/2">
          <!-- Theme Toggle Button -->
          <button id="theme-toggle-btn" type="button" class="border border-[var(--color-fg)] bg-[var(--color-bg-card)] text-[var(--color-fg)] p-1.5 flex items-center justify-center hover:bg-[var(--color-hover-bg)] hover:text-[var(--color-hover-text)] transition-all duration-150" aria-label="Toggle dark mode">
            <!-- Sun Icon (shows in dark theme) -->
            <svg id="theme-icon-sun" class="h-3.5 w-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
            </svg>
            <!-- Moon Icon (shows in light theme) -->
            <svg id="theme-icon-moon" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Language Selector dropdown -->
          <div class="relative inline-block text-left font-mono text-xs uppercase" id="lang-dropdown">
            <button type="button" class="border border-[var(--color-fg)] bg-[var(--color-bg-card)] px-3 py-1.5 flex items-center gap-1 hover:bg-[var(--color-hover-bg)] hover:text-[var(--color-hover-text)] transition-all duration-150" id="lang-btn">
              <span id="current-lang-label">EN</span>
              <svg class="h-3 w-3 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <div class="absolute right-0 mt-1 w-20 border border-[var(--color-fg)] bg-[var(--color-bg-card)] hidden z-50 shadow-md" id="lang-menu">
              <button class="w-full text-left px-3 py-1.5 hover:bg-[var(--color-hover-bg)] hover:text-[var(--color-hover-text)] transition-colors" data-lang="en">EN</button>
              <button class="w-full text-left px-3 py-1.5 hover:bg-[var(--color-hover-bg)] hover:text-[var(--color-hover-text)] transition-colors border-t border-[var(--color-fg)]" data-lang="id">ID</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Collapsible Mobile Drawer Menu (Visible on mobile only, expand down) -->
      <div id="mobile-menu-drawer" class="hidden md:hidden absolute top-full left-0 right-0 w-full bg-[var(--color-bg)] border-b-4 border-[var(--color-fg)] pt-3 flex-col gap-1 text-left font-bold z-50 shadow-lg px-2">
        <a href={`${homePrefix}#home`} class="mobile-nav-link py-2.5 border-b border-[var(--color-fg)]/10 hover:text-[var(--color-accent)] flex justify-between items-center px-2" id="mob-nav-home">
          <span class="lang-en">Home</span>
          <span class="lang-id">Beranda</span>
          <span class="text-neutral-400 font-mono text-[10px]">I</span>
        </a>
        <a href={`${homePrefix}#services`} class="mobile-nav-link py-2.5 border-b border-[var(--color-fg)]/10 hover:text-[var(--color-accent)] flex justify-between items-center px-2" id="mob-nav-services">
          <span class="lang-en">Services</span>
          <span class="lang-id">Layanan</span>
          <span class="text-neutral-400 font-mono text-[10px]">II</span>
        </a>
        <a href={`${homePrefix}#why-choose-us`} class="mobile-nav-link py-2.5 border-b border-[var(--color-fg)]/10 hover:text-[var(--color-accent)] flex justify-between items-center px-2" id="mob-nav-why-choose-us">
          <span class="lang-en">Why Us</span>
          <span class="lang-id">Mengapa Kami</span>
          <span class="text-neutral-400 font-mono text-[10px]">III</span>
        </a>
        <a href={`${homePrefix}#work`} class="mobile-nav-link py-2.5 border-b border-[var(--color-fg)]/10 hover:text-[var(--color-accent)] flex justify-between items-center px-2" id="mob-nav-work">
          <span class="lang-en">Work</span>
          <span class="lang-id">Portofolio</span>
          <span class="text-neutral-400 font-mono text-[10px]">IV</span>
        </a>
        <a href={`${homePrefix}#faq`} class="mobile-nav-link py-2.5 border-b border-[var(--color-fg)]/10 hover:text-[var(--color-accent)] flex justify-between items-center px-2" id="mob-nav-faq">
          <span class="lang-en">FAQ</span>
          <span class="lang-id">Tanya Jawab</span>
          <span class="text-neutral-400 font-mono text-[10px]">V</span>
        </a>
        <a href={`${homePrefix}#contact`} class="mobile-nav-link py-2.5 hover:text-[var(--color-accent)] flex justify-between items-center px-2" id="mob-nav-contact">
          <span class="lang-en">Contact</span>
          <span class="lang-id">Kontak</span>
          <span class="text-neutral-400 font-mono text-[10px]">VI</span>
        </a>
      </div>

    </nav>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // ----------------------------------------------------
    // Theme Toggle Logic
    // ----------------------------------------------------
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    if (themeBtn && sunIcon && moonIcon) {
      // Helper to update button icons
      const updateThemeIcons = (isDark: boolean) => {
        if (isDark) {
          sunIcon.classList.remove('hidden');
          moonIcon.classList.add('hidden');
        } else {
          sunIcon.classList.add('hidden');
          moonIcon.classList.remove('hidden');
        }
      };

      // Set initial state of icons based on html class
      const isInitialDark = document.documentElement.classList.contains('dark');
      updateThemeIcons(isInitialDark);

      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const nextTheme = isDark ? 'light' : 'dark';

        if (nextTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        localStorage.setItem('web-agency-theme', nextTheme);
        updateThemeIcons(nextTheme === 'dark');

        // Dispatch custom event for React components
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: nextTheme } }));
      });
    }

    // ----------------------------------------------------
    // Language Dropdown Selector Logic
    // ----------------------------------------------------
    const dropdown = document.getElementById('lang-dropdown');
    const btn = document.getElementById('lang-btn');
    const menu = document.getElementById('lang-menu');
    const label = document.getElementById('current-lang-label');

    if (btn && menu && label) {
      // Set initial label on mount
      const savedLang = localStorage.getItem('web-agency-lang') || 'en';
      label.textContent = savedLang.toUpperCase();

      // Toggle menu
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.classList.toggle('hidden');
      });

      // Close when clicking outside
      document.addEventListener('click', () => {
        menu.classList.add('hidden');
      });

      // Handle language selection
      const options = menu.querySelectorAll('button[data-lang]');
      options.forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const lang = opt.getAttribute('data-lang') || 'en';
          
          // Update label
          label.textContent = lang.toUpperCase();
          
          // Update document element class
          document.documentElement.classList.remove('lang-en', 'lang-id');
          document.documentElement.classList.add(`lang-${lang}`);
          
          // Save choice
          localStorage.setItem('web-agency-lang', lang);
          
          // Dispatch custom event for React components
          window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }));
          
          // Close menu
          menu.classList.add('hidden');
        });
      });
    }

    // ----------------------------------------------------
    // Mobile Drawer Toggle Logic
    // ----------------------------------------------------
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
    
    if (mobileMenuBtn && mobileMenuDrawer) {
      const openLabels = mobileMenuBtn.querySelectorAll('.menu-text-open');
      const closeLabels = mobileMenuBtn.querySelectorAll('.menu-text-close');
      const menuIconBars = mobileMenuBtn.querySelector('.menu-icon-bars');
      const menuIconCross = mobileMenuBtn.querySelector('.menu-icon-cross');

      const toggleMobileMenu = (e: Event) => {
        e.stopPropagation();
        const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
        
        // Toggle expanded state attribute
        mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
        
        // Toggle drawer visibility
        mobileMenuDrawer.classList.toggle('hidden');
        mobileMenuDrawer.classList.toggle('flex');
        
        // Toggle Text labels
        openLabels.forEach(el => el.classList.toggle('hidden'));
        closeLabels.forEach(el => el.classList.toggle('hidden'));
        
        // Toggle SVG paths
        if (menuIconBars && menuIconCross) {
          menuIconBars.classList.toggle('hidden');
          menuIconCross.classList.toggle('hidden');
        }
      };

      mobileMenuBtn.addEventListener('click', toggleMobileMenu);

      // Close mobile drawer when clicking a mobile nav link
      const mobileNavLinks = mobileMenuDrawer.querySelectorAll('.mobile-nav-link');
      mobileNavLinks.forEach(link => {
        link.addEventListener('click', () => {
          // Collapse drawer
          mobileMenuBtn.setAttribute('aria-expanded', 'false');
          mobileMenuDrawer.classList.add('hidden');
          mobileMenuDrawer.classList.remove('flex');
          
          // Reset button texts/icons
          openLabels.forEach(el => el.classList.remove('hidden'));
          closeLabels.forEach(el => el.classList.add('hidden'));
          
          if (menuIconBars && menuIconCross) {
            menuIconBars.classList.remove('hidden');
            menuIconCross.classList.add('hidden');
          }
        });
      });
    }
  });
</script>
